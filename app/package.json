{
  "name": "specs-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:mock": "vite --host 0.0.0.0 --port 5174 --strictPort --mode mock",
    "dev:mock:v2": "vite --host 0.0.0.0 --port 5176 --strictPort --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o specs.ehpk --sdk-ver 0.0.16",
    "simulate": "evenhub-simulator http://localhost:5174 --automation-port 9898",
    "simulate:v2": "node tests/simulator-smoke.mjs --launch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:simulator": "node tests/simulator-smoke.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@fontsource/carlito": "^5.3.0",
    "@sentry/browser": "11.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
