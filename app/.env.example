# Exact full origin, must match the whitelist entry in app/app.json (no wildcards,
# no bare host) or the Even network layer blocks the request before CORS.
VITE_RELAY_ORIGIN=http://localhost:8080

# Public Sentry DSN. This is the ONLY secret allowed in the app bundle --
# .ehpk contents can be extracted.
VITE_SENTRY_DSN=

# 1 = no network at all, api/client.ts serves app/src/mock/ fixtures.
VITE_MOCK=0

# Optional: /v1/ask timeout override in ms (contract default 8000).
VITE_ASK_TIMEOUT_MS=8000
