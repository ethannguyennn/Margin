# Exact full origin, must match the whitelist entry in app/app.json (no wildcards,
# no bare host) or the Even network layer blocks the request before CORS.
VITE_RELAY_ORIGIN=https://45-32-88-132.sslip.io

# Public Sentry DSN. This is the ONLY secret allowed in the app bundle --
# .ehpk contents can be extracted.
VITE_SENTRY_DSN=

# 1 = no network at all, api/client.ts serves app/src/mock/ fixtures.
VITE_MOCK=0

# /v1/ask timeout in ms: covers two Gemini attempts; keep it above the relay ASK_BUDGET_S.
VITE_ASK_TIMEOUT_MS=50000

# Optional: 1 = send Sentry events through <relay>/v1/sentry-tunnel so the app needs
# only the one whitelisted origin. Leave 0 until Part 3 ships that route.
VITE_SENTRY_TUNNEL=0
