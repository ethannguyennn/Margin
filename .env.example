# Margin relay -- every env var in the project. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored. NEVER commit a real key. Values here stay empty.
# App-side vars (VITE_RELAY_ORIGIN, VITE_SENTRY_DSN, VITE_MOCK) live in app/.env.example.

# --- Gemini (relay only; never in the app bundle) -----------------------------
GEMINI_API_KEY=
# Model IDs are NOT hardcoded anywhere. Look them up at
# https://ai.google.dev/gemini-api/docs/models . As of 2026-10-17 the docs list
# gemini-3.5-flash-lite (stable, audio input, structured output) and
# gemini-embedding-2 (stable, output_dimensionality 128-3072, 768 recommended).
GEMINI_MODEL_GENERATE=
GEMINI_MODEL_TRANSCRIBE=
GEMINI_MODEL_EMBED=
# v2: material extraction (page images) + structuring. Part 4 picks it; it needs
# image input and structured output. Part 4 verified gemini-3.8-flash (stable) on
# 2026-10-17 and ran the conversion eval on it; its free tier is ~20 requests/day.
GEMINI_MODEL_CONVERT=
# Must equal the vector(N) column Part 5's migration renders.
EMBED_DIM=768

# --- Tiger Cloud (Postgres + pgvector + Timescale) ----------------------------
DATABASE_URL=
# Stretch: zero-copy fork with SOP rev D, used only when ENABLE_REVISION_FORK=1.
DATABASE_URL_FORK=
ENABLE_REVISION_FORK=0

# --- Sentry -------------------------------------------------------------------
SENTRY_DSN_RELAY=
# Public DSN for the app build (copy into app/.env as VITE_SENTRY_DSN).
SENTRY_DSN_APP=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Notifier (Part 5) ----------------------------------------------------------
# console | photon
NOTIFIER=console
PHOTON_API_KEY=
SUPERVISOR_ADDRESS=

# --- Retrieval gate thresholds (Part 4 tunes against eval/qa.jsonl) -----------
# Unset = gate disabled in real mode (refusal then relies on generator + verifier).
NOT_FOUND_MIN_SIM=
NOT_FOUND_MIN_RRF=

# --- Server -------------------------------------------------------------------
# Must equal the app.json network whitelist entry exactly: https://getyourassto.work
PUBLIC_ORIGIN=
# Comma-separated exact origins the WebView / simulator send. VERIFY the device
# origin from the relay's "CORS rejected origin" WARN log; do not guess.
# Local dev: the Even Hub app (lens + phone screen, Vite) http://localhost:5174
#   ALLOWED_ORIGINS=http://localhost:5174
# Add device / preview origins exactly as the WARN log prints them.
ALLOWED_ORIGINS=
# Optional regex for LAN dev servers (the app opened from a phone on the same Wi-Fi):
#   ALLOWED_ORIGIN_REGEX=^http://(192\.168|10)\.\d+\.\d+(\.\d+)?:517[45]$
ALLOWED_ORIGIN_REGEX=
# 1 = no DB, no Gemini, no pipeline modules needed.
MOCK_MODE=0
MAX_AUDIO_SECONDS=8
# Bearer token for POST /v1/ingest. Empty disables the route.
ADMIN_TOKEN=
LOG_LEVEL=INFO
# Default: <repo>/corpus (the Docker image sets /app/corpus).
CORPUS_DIR=

# --- v2: employer portal, devices, uploads, conversion ------------------------
# The one shared supervisor token for every portal route (typed into the portal's
# login screen, never bundled). Empty = portal routes refuse everything (401).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_TOKEN=
# Device tokens are random 32-byte values stored only as SHA-256, so no signing
# secret is needed (README-PART-3 lists DEVICE_TOKEN_SECRET only "if you sign anything").
MAX_UPLOAD_MB=20
CONVERT_TIMEOUT_S=180
CONVERT_CONCURRENCY=2
# Pair codes expire after 15 min; POST /v1/devices/pair is limited per client IP.
PAIR_CODE_TTL_S=900
PAIR_RATE_PER_MIN=10

# --- Deploy (deploy/docker-compose.yml + Caddy on the Vultr VM) ---------------
# Caddy serves and gets a TLS cert for this host (a comma-separated list works,
# e.g. "getyourassto.work, 45-32-88-132.sslip.io"); DNS A record -> the VM's IP.
# The API is at https://<host>/v1/..., the employer portal at https://<host>/portal/.
MARGIN_DOMAIN=
# Let's Encrypt account email.
ACME_EMAIL=
# For `make deploy-remote`: ssh target of the VM, e.g. root@203.0.113.10
VM_HOST=
